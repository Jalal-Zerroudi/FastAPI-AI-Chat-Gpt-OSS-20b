# Copy this file to .env and replace the placeholder values.
# Never commit the resulting .env file.

# OpenAI-compatible LLM endpoint
ATLASCLOUD_API_URL=https://api.atlascloud.ai/v1/chat/completions
ATLASCLOUD_API_KEY=replace-with-your-api-key

# Optional Bearer token used to protect authenticated endpoints
API_SECRET=replace-with-a-strong-random-secret

# Comma-separated hostnames and browser origins
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Optional comma-separated reverse proxy IPs or CIDR networks
# Leave empty when the app is not behind a trusted proxy.
TRUSTED_PROXIES=
